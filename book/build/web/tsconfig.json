{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@server/*": ["../src/server/*"],
      "@contracts": ["../src/contracts/index.ts"],
      "@contracts/*": ["../src/contracts/*"],
      "@workflow": ["../src/workflow/index.ts"],
      "@workflow/*": ["../src/workflow/*"],
      "@project/*": ["../src/project/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
