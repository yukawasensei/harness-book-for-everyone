{
  "scenes": [
    {
      "scene_id": "S01",
      "heading": "外景·旧候船亭·傍晚",
      "summary": "空白磁片引发程禾与麦冬的争执。",
      "lines": [
        {
          "kind": "action",
          "text": "程禾在旧时刻表前排齐留言，麦冬把橙色空白磁片放在中央。蓝色机械计时器的指针停着。"
        },
        {
          "kind": "dialogue",
          "character": "程禾",
          "text": "这一格也要填上，大家才知道这里能做什么。"
        },
        {
          "kind": "dialogue",
          "character": "麦冬",
          "text": "这一格有人，只是他还没说话。"
        },
        {
          "kind": "action",
          "text": "麦冬指向远处修表间。程禾收回伸向磁片的手，拿起计时器。"
        }
      ]
    },
    {
      "scene_id": "S02",
      "heading": "内景·社区修表间·傍晚",
      "summary": "陆岑修好计时器，解释自己为何不曾停留。",
      "lines": [
        {
          "kind": "action",
          "text": "陆岑在木工作台前转动蓝色机械计时器的发条。程禾与麦冬并肩等待，麦冬握着橙色空白磁片。"
        },
        {
          "kind": "dialogue",
          "character": "程禾",
          "text": "计时器停了，我们的留言角也空着一格。"
        },
        {
          "kind": "dialogue",
          "character": "陆岑",
          "text": "表可以重新走。可我上次在亭子里说再见，只说到一半。"
        },
        {
          "kind": "dialogue",
          "character": "麦冬",
          "text": "那我们等你说完。"
        },
        {
          "kind": "action",
          "text": "程禾不再催促，接过重新响起的计时器。"
        }
      ]
    },
    {
      "scene_id": "S03",
      "heading": "外景·旧候船亭·入夜前",
      "summary": "程禾把填满格子的目标改为给人留出讲述的时间。",
      "lines": [
        {
          "kind": "action",
          "text": "三人坐在旧时刻表前。程禾把计时器拨到三分钟，麦冬翻转橙色空白磁片。"
        },
        {
          "kind": "dialogue",
          "character": "程禾",
          "text": "这一格先不填。三分钟，够你开个头吗？"
        },
        {
          "kind": "dialogue",
          "character": "陆岑",
          "text": "那天也是这样的风。"
        },
        {
          "kind": "action",
          "text": "麦冬轻轻按住磁片，程禾把目光从格子转向陆岑。指针继续走，镜头留在三人身上。"
        }
      ]
    }
  ]
}
